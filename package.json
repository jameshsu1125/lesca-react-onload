{
  "name": "lesca-react-onload",
  "private": false,
  "description": "Progress and timing provided for loading and animation.",
  "version": "3.0.0",
  "type": "module",
  "keywords": [
    "lesca",
    "images onload"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=DEV vite --host",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "rm": "rm -rf node_modules/ dist/ package-lock.json"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "path": "^0.12.7",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "types": "./lib/index.d.ts"
}
