{
  "name": "lesca-react-onload",
  "private": false,
  "description": "Progress and timing provided for loading and animation.",
  "version": "3.0.0",
  "type": "module",
  "keywords": [
    "lesca",
    "images onload"
  ],
  "files": [
    "lib"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js"
    }
  },
  "scripts": {
