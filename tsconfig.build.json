{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "lib",
    "node_modules",
    "src/root.tsx",
    "src/flash.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
